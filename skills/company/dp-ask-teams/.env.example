# dp-ask-teams env template — copy to a .env next to this skill (or anywhere)
# and pass --env-file, or keep using your existing agent-eval .env.
#
# Both environments' tokens can live here; --env picks which to use.
# Tokens are synced automatically from the running, logged-in DeepWorks
# desktop app (test desktop port 9223, prod desktop port 9228) — you normally
# do NOT need to fill these by hand.

# test cloud (test.deepworks.cn)
AGENT_TEAMS_TOKEN=
# prod cloud (agentteam.deepworks.cn)
AGENT_TEAMS_TOKEN_PROD=

# Optional overrides (defaults shown)
# AGENT_TEAMS_BASE_URL=https://test.deepworks.cn/deepexi-agent-teams-backend
# AGENT_TEAMS_BASE_URL_PROD=https://agentteam.deepworks.cn/deepexi-agent-teams-backend
# AGENT_TEAMS_WORKSPACE_SLUG=deepsense-workspace
# AGENT_TEAMS_PROJECT_NAME=
# AGENT_TEAMS_AUTH_MODE=iam
